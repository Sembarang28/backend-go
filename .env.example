# ==============================================================================
# Server & Environment Configuration
# ==============================================================================
APP_ENV=development
SERVER_ADDRESS=127.0.0.1:8080
GRPC_ADDRESS=127.0.0.1:50051
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

# ==============================================================================
# Database Configuration (Primary & Read-Replica)
# ==============================================================================
DB_PRIMARY_DSN=postgres://postgres:postgres@127.0.0.1:5432/appdb?sslmode=disable
DB_REPLICA_DSN=postgres://postgres:postgres@127.0.0.1:5433/appdb?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# ==============================================================================
# Redis & Caching Configuration
# ==============================================================================
REDIS_MODE=single
REDIS_ADDRESSES=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=5m

# ==============================================================================
# Message Broker (NATS / Kafka)
# ==============================================================================
NATS_ADDRESS=nats://127.0.0.1:4222

# ==============================================================================
# Transactional Outbox Worker Configuration
# ==============================================================================
OUTBOX_PARTITIONS=8
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=200ms
OUTBOX_MAX_RETRIES=5

# ==============================================================================
# Idempotency & Distributed Rate Limiter
# ==============================================================================
IDEMPOTENCY_TTL=24h
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m